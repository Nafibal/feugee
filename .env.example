# Local Postgres (docker compose up -d) — user/password/db default to "feugee"
POSTGRES_USER=feugee
POSTGRES_PASSWORD=feugee
POSTGRES_DB=feugee
POSTGRES_PORT=5432
DATABASE_URL=postgres://feugee:feugee@localhost:5432/feugee

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# First admin account, seeded by `npm run seed`
PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=change-me

# Asset storage — production uses Cloudflare R2; local dev points the same
# credentials at an S3-compatible cluster instead. Exactly one of
# R2_ACCOUNT_ID (production, endpoint derived) or R2_ENDPOINT (override) is
# required — see docs/adr/0002.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Production: R2_ACCOUNT_ID=
# Local dev example (Biznet Gio Neo): R2_ENDPOINT=https://nos.wjv-1.neo.id
